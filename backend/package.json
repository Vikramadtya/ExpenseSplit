    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.10.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
