# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/expensesplit
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# Google sign-in
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Requests per minute per client (sign-in, uploads and deletion have their own, lower limits)
THROTTLE_LIMIT=120
# Set to true to stop the recurring-expense timer (e.g. on a second instance or in tests)
DISABLE_SCHEDULERS=false

# ── Optional features (each is simply off until configured) ─────────────────
# Receipt scanning: reads receipt photos with a Claude vision model. Without a key, users
# enter items by hand. OCR_MODEL overrides the default model.
ANTHROPIC_API_KEY=
OCR_MODEL=
# Where receipt photos are stored (local disk). Default: ./data/receipts
RECEIPTS_DIR=

# Browser push notifications. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email for reminders and failure notices (Resend). Without these, emails are only logged.
RESEND_API_KEY=
MAIL_FROM=ExpenseSplit <noreply@yourdomain.com>

# ── Observability ───────────────────────────────────────────────────────────
ENABLE_OPENTELEMETRY=false
DB_LOGGING=false

# ── Development only (ignored when NODE_ENV=production) ─────────────────────
BYPASS_GOOGLE_OAUTH=false
